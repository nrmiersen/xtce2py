"""Contains pydantic models for command containers."""

from typing import Annotated, Literal, Union

from pydantic import BeforeValidator, Field

from {{ base_module }} import XtcePacket, enum_validator

{% for imp in extra_imports %}
{{ imp }}
{% endfor %}

{% for cmd in commands %}
class {{ cmd.class_name }}({{ cmd.parent_class }}):
    """{{ cmd.docstring }}"""

    {%- for field in cmd.fields %}
    {{ field.name }}: {{ field.type_hint }}{% if field.default %} = {{ field.default }}{% endif %}
    {%- endfor %}

    {%- if not cmd.fields and not cmd.inherited_defaults %}
    pass
    {%- endif %}

    {%- if cmd.inherited_defaults %}

    # Overridden inherited defaults
    {%- for key, data in cmd.inherited_defaults.items() %}
    {{ key }}: Literal[{{ data.value }}] = {{ data.value }}
    {%- endfor %}
    {%- endif %}

    def _build_recipe(self) -> list[dict]:
        """Append this command's fields to the encoding recipe."""
        recipe = super()._build_recipe()

        {%- for step in cmd.encode_steps %}
        {%- if step.condition %}
        if {{ step.condition }}:
        {%- endif %}
        {%- set indent = "    " if step.condition else "" %}
        {{ indent }}recipe.append({
        {{ indent }}    "name": "{{ step.name }}",
        {{ indent }}    "value": {{ step.value_src }},
        {{ indent }}    "bits": {{ step.encoding.bits }},
        {{ indent }}    "encoding": "{{ step.encoding.encoding }}",
        {{ indent }}    "byte_order": "{{ step.encoding.byte_order }}",
        {{ indent }}    "reverse_bits": {{ step.encoding.reverse_bits }},
        {{ indent }}})
        {%- endfor %}

        return recipe

{% endfor %}