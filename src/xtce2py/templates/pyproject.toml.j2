[project]
name = "{{ context.dist_name }}"
version = "{{ context.version }}"
description = "Python package generated from XTCE space system: {{ context.metadata.name }}"
dependencies = [
    "pydantic>=2.11.7",
    "setuptools>=80.9.0",
    "bitstring>=4.3.1",
]
requires-python = ">=3.11"
readme = "README.md"
license = { text = "MIT" }

[tool.ruff]
line-length = 88

[tool.ruff.lint]
select = [
    "F",  # pyflakes
    "E",  # pycodestyle errors
    "W",  # pycodestyle warnings
    "I",  # isort
    "D",  # pydocstyle
]

# Ignore specific conflicting docstring rules
ignore = [
    "D203",
    "D213",
    "E501",
]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.isort]
known-first-party = ["{{ context.package_name }}"]
