[project]
name = "{{ context.dist_name }}"
version = "{{ context.version }}"
description = "Python package generated from XTCE space system: {{ context.metadata.name }}"
dependencies = [
    "pydantic>=2.11.7",
    "setuptools>=80.9.0",
    "bitstring>=4.3.1",
]
requires-python = ">=3.11"
readme = "README.md"
license = { text = "MIT" }

[tool.ruff]
line-length = 88

[tool.ruff.lint]
select = [
    "I",    # isort
    "D",    # pydocstyle
]

# Ignore specific conflicting docstring rules
ignore = [
    "D203",  # 1 blank line required before class docstring (conflicts with D211)
    "D213",  # Multi-line docstring summary should start at the second line (conflicts with D212)
]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.isort]
known-first-party = ["{{ context.package_name }}"]
